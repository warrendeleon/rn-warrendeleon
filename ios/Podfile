# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# react-native-permissions setup
def node_require(script)
  require Pod::Executable.execute_command('node', ['-p',
    "require.resolve(
      '#{script}',
      {paths: [process.argv[1]]},
    )", __dir__]).strip
end

node_require('react-native-permissions/scripts/setup.rb')

# Configure which iOS permissions to include for profile picture feature
setup_permissions([
  'Camera',
  'PhotoLibrary',
])

platform :ios, min_ios_version_supported
prepare_react_native_project!
use_frameworks! :linkage => :static

$RN_ROOT = "../node_modules/react-native"

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'warrendeleon' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # Certificate Pinning for SSL/TLS security
  pod 'TrustKit', '~> 3.0'

  # Note: RCT-Folly (and its fmt / fast_float deps) are provided by
  # use_react_native! above. RN 0.85 wires all three third-party podspecs with
  # modular headers, so declaring RCT-Folly here again conflicts on the fmt
  # version. Detox picks up the RCT-Folly that use_react_native! installs.

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      :ccache_enabled => true
    )

    # ─── TEMPORARY WORKAROUND ─────────────────────────────────────────
    # Workaround: fmt + Apple Clang 17 (Xcode 26+) consteval clash.
    # The fmt version pulled in transitively by React Native uses
    # consteval format-string validation that fails to instantiate under
    # Apple Clang 17. Forcing FMT_USE_CONSTEVAL=0 falls back to runtime
    # checks. Only the fmt target is touched.
    #
    # REMOVAL: Drop this entire block (and TASK-402) once React Native
    # bumps fmt to a version that compiles under Apple Clang 17. To check:
    # comment out, run `bundle exec pod install`, build. If it succeeds,
    # the workaround is no longer needed and should be removed.
    # See docs/planning/tasks/TASK-402-remove-fmt-consteval-workaround.md
    # ──────────────────────────────────────────────────────────────────
    fmt_target = installer.pods_project.targets.find { |t| t.name == 'fmt' }
    if fmt_target
      Pod::UI.puts "[Podfile] ⚠️  Applying fmt FMT_USE_CONSTEVAL=0 workaround (TASK-402). Verify still needed when bumping RN or Xcode.".yellow
      fmt_target.build_configurations.each do |config|
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)']
        unless config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'].include?('FMT_USE_CONSTEVAL=0')
          config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'FMT_USE_CONSTEVAL=0'
        end
      end
    end
  end
end
