{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": [
      "ES2020"
    ],
    "moduleResolution": "node",
    "jsx": "react",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "strict": false,
    "baseUrl": ".",
    "paths": {
      "@app": [
        "src"
      ],
      "@app/*": [
        "src/*"
      ]
    },
    "types": [
      "node",
      "detox"
    ],
    "ignoreDeprecations": "6.0",
    "rootDir": "."
  },
  "ts-node": {
    "transpileOnly": true,
    "compilerOptions": {
      "module": "commonjs",
      "moduleResolution": "node",
      "jsx": "react",
      "ignoreDeprecations": "6.0"
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}
